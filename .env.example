# Development values only. Generate independent random secrets outside local development.
POSTGRES_USER=generation
POSTGRES_PASSWORD=generation
POSTGRES_DB=generation
DATABASE_URL=postgresql+asyncpg://generation:generation@db:5432/generation
ALPHA_URL=http://alpha:8001
BETA_URL=http://beta:8001
CALLBACK_BASE_URL=http://api:8000
ALPHA_SECRET=local-alpha-secret
BETA_SECRET=local-beta-secret
PAYMENT_SECRET=local-payment-secret
PROVIDER_API_KEY=local-provider-api-key
PROVIDER_TIMEOUT=60
HTTP_TIMEOUT=5
DISPATCH_LEASE=15
WORKER_POLL=0.25
PROVIDER_DELAY_MIN=2
PROVIDER_DELAY_MAX=20
LOG_LEVEL=INFO
